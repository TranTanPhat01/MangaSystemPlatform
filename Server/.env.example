POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
# File API storage override (Local remains the development default when omitted)
FILESTORAGE__PROVIDER=Minio
MINIO__ENDPOINT=localhost:9000
MINIO__ACCESSKEY=admin
MINIO__SECRETKEY=password123
SEQ_ADMIN_PASSWORD=change-this-local-seq-password
JWT_ISSUER=MangaSystemPlatform.Identity
JWT_AUDIENCE=MangaSystemPlatform.Client
# Set a unique secret of at least 32 characters through a local .env, user secret, or external secret store.
JWT_SECRET_KEY=<set-a-unique-jwt-signing-secret>
INTERNAL_GRPC_API_KEY=dev-internal-grpc-key
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-development-admin-password
# Keep both false in deployed Compose. Enable recovery only for one controlled startup,
# then set it back to false immediately.
IDENTITY_BOOTSTRAP_ENABLED=false
IDENTITY_BOOTSTRAP_RECOVERY_ENABLED=false
# Comma-separated origins are not supported by ASP.NET configuration binding here;
# use indexed values (Gateway__Cors__AllowedOrigins__0, __1) for deployment overrides.
GATEWAY__CORS__ALLOWEDORIGINS__0=http://localhost:3000
GATEWAY__CORS__ALLOWEDORIGINS__1=http://localhost:3001
GATEWAY__HEALTHCHECKTIMEOUTSECONDS=3
GATEWAY__RATELIMITING__PERMITLIMIT=300
GATEWAY__RATELIMITING__WINDOWSECONDS=60
GATEWAY__DEFAULTPROXYTIMEOUTSECONDS=120
GATEWAY__FILEPROXYTIMEOUTSECONDS=600
GATEWAY__MAXFILEUPLOADBYTES=52428800
GATEWAY__HEALTH__EXPOSESERVICEDETAILS=false
# Set these to true only behind a TLS-terminating ingress that appears in the trusted proxy configuration below.
GATEWAY__TRANSPORTSECURITY__ENABLEHTTPSREDIRECTION=false
GATEWAY__TRANSPORTSECURITY__ENABLEHSTS=false
GATEWAY__TRANSPORTSECURITY__HSTSMAXAGEDAYS=365
# Keep disabled for local Docker. Production must list only trusted ingress IPs or CIDRs.
FORWARDEDHEADERS__ENABLED=false
# FORWARDEDHEADERS__KNOWNPROXIES__0=<trusted-ingress-ip>
# FORWARDEDHEADERS__KNOWNNETWORKS__0=<trusted-ingress-cidr>
# Optional. Leave empty when no OTLP collector is available.
OTEL_EXPORTER_OTLP_ENDPOINT=

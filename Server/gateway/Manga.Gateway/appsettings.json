{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "Manga.Gateway"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        }
      },
      "manga-route": {
        "ClusterId": "manga-cluster",
        "Match": {
          "Path": "/manga/{**catch-all}"
        }
      },
      "files-route": {
        "ClusterId": "files-cluster",
        "Match": {
          "Path": "/files/{**catch-all}"
        }
      },
      "editorial-route": {
        "ClusterId": "editorial-cluster",
        "Match": {
          "Path": "/editorial/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://localhost:5207/"
          }
        }
      },
      "manga-cluster": {
        "Destinations": {
          "manga-api": {
            "Address": "http://localhost:5078/"
          }
        }
      },
      "files-cluster": {
        "Destinations": {
          "file-api": {
            "Address": "http://localhost:5154/"
          }
        }
      },
      "editorial-cluster": {
        "Destinations": {
          "editorial-api": {
            "Address": "http://localhost:5206/"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notification-api": {
            "Address": "http://localhost:5210/"
          }
        }
      }
    }
  }
}

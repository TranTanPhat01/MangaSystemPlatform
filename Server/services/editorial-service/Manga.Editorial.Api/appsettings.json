{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "Manga.Editorial.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EditorialDb": "Host=localhost;Port=5432;Database=EditorialDB;Username=postgres;Password=123456"
  },
  "Jwt": {
    "Issuer": "MangaSystemPlatform.Identity",
    "Audience": "MangaSystemPlatform.Client",
    "SecretKey": "change-this-development-secret-key-32-plus-chars"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "manga-system-events"
  },
  "Grpc": {
    "Manga": {
      "Address": "http://localhost:6078",
      "TimeoutSeconds": 2
    }
  },
  "InternalGrpc": {
    "ApiKey": "dev-internal-grpc-key"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "admin",
    "SecretKey": "password123",
    "BucketName": "manga-assets",
    "UseSSL": false
  }
}

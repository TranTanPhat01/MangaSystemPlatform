POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-strong-postgres-password

RABBITMQ_DEFAULT_USER=replace-with-rabbitmq-user
RABBITMQ_DEFAULT_PASS=replace-with-strong-rabbitmq-password

MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-strong-minio-secret
MINIO_PUBLIC_BASE_URL=https://files.example.com

SEQ_ADMIN_PASSWORD=replace-with-strong-seq-admin-password

JWT_ISSUER=https://identity.example.com
JWT_AUDIENCE=manga-system-platform
JWT_SECRET_KEY=replace-with-strong-jwt-signing-key-at-least-32-bytes
INTERNAL_GRPC_API_KEY=replace-with-strong-internal-grpc-api-key

GATEWAY__CORS__ALLOWEDORIGINS__0=https://app.example.com
GATEWAY__CORS__ALLOWEDORIGINS__1=
GATEWAY__TRANSPORTSECURITY__ENABLEHTTPSREDIRECTION=true
GATEWAY__TRANSPORTSECURITY__ENABLEHSTS=true
GATEWAY__TRANSPORTSECURITY__HSTSMAXAGEDAYS=365
GATEWAY__TRANSPORTSECURITY__HTTPSPORT=443

FORWARDEDHEADERS__ENABLED=true
FORWARDEDHEADERS__KNOWNPROXIES__0=replace-with-reverse-proxy-ip
FORWARDEDHEADERS__KNOWNNETWORKS__0=

IDENTITY_BOOTSTRAP_ENABLED=false
IDENTITY_BOOTSTRAP_RECOVERY_ENABLED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

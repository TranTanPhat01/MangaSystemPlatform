{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "Manga.File.Api"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://localhost:5154",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:6154",
        "Protocols": "Http2"
      }
    }
  },
  "InternalGrpc": {
    "ApiKey": "dev-internal-grpc-key"
  },
  "ConnectionStrings": {
    "FileDb": "Host=localhost;Port=5432;Database=FileServiceDB;Username=postgres;Password=12345"
  },
  "FileStorage": {
    "Provider": "Local",
    "RootPath": "storage/files",
    "MaxFileSizeInMb": 20,
    "AllowedExtensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".webp",
      ".pdf",
      ".psd"
    ]
  },
  "Jwt": {
    "Issuer": "MangaSystemPlatform.Identity",
    "Audience": "MangaSystemPlatform.Client",
    "SecretKey": "change-this-development-secret-key-32-plus-chars"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "manga-system-events"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "admin",
    "SecretKey": "password123",
    "BucketName": "manga-assets",
    "UseSSL": false
  }
}

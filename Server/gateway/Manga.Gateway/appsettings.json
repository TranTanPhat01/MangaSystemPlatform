{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "Manga.Gateway"
    }
  },
  "AllowedHosts": "*",
  "App": { "ServiceName": "Gateway", "Version": "local", "Build": "unknown" },
  "Gateway": {
    "Cors": {
      "AllowedOrigins": [ "http://localhost:3000", "http://localhost:3001" ]
    },
    "HealthCheckTimeoutSeconds": 3,
    "Health": {
      "ExposeServiceDetails": false
    },
    "RateLimiting": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "DefaultProxyTimeoutSeconds": 120,
    "FileProxyTimeoutSeconds": 600,
    "MaxFileUploadBytes": 52428800,
    "TransportSecurity": {
      "EnableHttpsRedirection": true,
      "EnableHsts": true,
      "HstsMaxAgeDays": 365
    },
    "SecurityHeaders": {
      "Enabled": true,
      "ReferrerPolicy": "no-referrer",
      "RemoveServerHeader": true
    }
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Jwt": {
    "Issuer": "MangaSystemPlatform.Identity",
    "Audience": "MangaSystemPlatform.Client",
    "SecretKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [ { "RequestHeaderRemove": "Cookie" } ]
      },
      "manga-route": {
        "ClusterId": "manga-cluster",
        "Match": {
          "Path": "/manga/{**catch-all}"
        },
        "Transforms": [ { "RequestHeaderRemove": "Cookie" } ]
      },
      "files-route": {
        "ClusterId": "files-cluster",
        "Match": {
          "Path": "/files/{**catch-all}"
        },
        "Transforms": [ { "RequestHeaderRemove": "Cookie" } ]
      },
      "editorial-route": {
        "ClusterId": "editorial-cluster",
        "Match": {
          "Path": "/editorial/{**catch-all}"
        },
        "Transforms": [ { "RequestHeaderRemove": "Cookie" } ]
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        },
        "Transforms": [ { "RequestHeaderRemove": "Cookie" } ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "HttpClient": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "identity-api": {
            "Address": "http://identity-api:8080/"
          }
        }
      },
      "manga-cluster": {
        "HttpClient": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "manga-api": {
            "Address": "http://manga-api:8080/"
          }
        }
      },
      "files-cluster": {
        "HttpClient": { "ActivityTimeout": "00:10:00" },
        "Destinations": {
          "file-api": {
            "Address": "http://file-api:8080/"
          }
        }
      },
      "editorial-cluster": {
        "HttpClient": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "editorial-api": {
            "Address": "http://editorial-api:8080/"
          }
        }
      },
      "notifications-cluster": {
        "HttpClient": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "notification-api": {
            "Address": "http://notification-api:8080/"
          }
        }
      }
    }
  }
}
